generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("construction_storage_PRISMA_DATABASE_URL")
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  password        String
  name            String
  phone           String?
  role            String          @default("CLIENT")
  // PENDING_APPROVAL | UNDER_REVIEW | APPROVED | VERIFIED | REJECTED | SUSPENDED
  status          String          @default("PENDING_APPROVAL")
  // Document verification: PENDING | UNDER_REVIEW | VERIFIED | REJECTED | REUPLOAD_REQUIRED
  verificationStatus String       @default("PENDING")
  verificationNote String?
  agreedTermsAt   DateTime?
  approvedAt      DateTime?
  verifiedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  reservations    Reservation[]
  toolRentals     ToolRental[]
  hireRequests    HireRequest[]
  projects        Project[]       @relation("ClientProjects")
  managedProjects Project[]       @relation("ManagerProjects")
  payments        Payment[]
  documents       UserDocument[]
  notifications   Notification[]
  adminLogs       AdminActivityLog[] @relation("AdminActor")
}

model UserDocument {
  id          String   @id @default(cuid())
  userId      String
  type        String   // ID | PROOF_OF_ADDRESS | PASSPORT_PHOTO | CAC | OTHER
  label       String?
  fileUrl     String
  fileName    String?
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED | REUPLOAD_REQUIRED
  rejectReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CategoryDefault {
  id                  String @id @default(cuid())
  category            String @unique // HOUSE | HOTEL | LAND | TOOLS | WORKERS | OTHER
  name                String
  // Reservation hold duration in hours
  defaultExpiryHours  Int
  sortOrder           Int    @default(0)
  active              Boolean @default(true)
  updatedAt           DateTime @updatedAt
}

model Asset {
  id              String        @id @default(cuid())
  title           String
  description     String
  type            String        // HOUSE | HOTEL | LAND | APARTMENT | COMMERCIAL | OTHER
  price           Float
  location        String
  size            String?
  bedrooms        Int?
  bathrooms       Int?
  images          String        // JSON array of URLs
  status          String        @default("AVAILABLE") // AVAILABLE | RESERVED | SOLD | INACTIVE
  features        String?
  // Override category default expiry (hours). null = use CategoryDefault
  reservationHours Int?
  // Installment config (optional)
  installmentCount Int?
  installmentPercents String?   // JSON e.g. [30,30,40]
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  reservations    Reservation[]
}

model Reservation {
  id              String   @id @default(cuid())
  userId          String
  assetId         String
  // PENDING | CONFIRMED | PARTIALLY_PAID | FULLY_PAID | CANCELLED | EXPIRED
  status          String   @default("PENDING")
  deposit         Float
  totalAmount     Float?
  amountPaid      Float    @default(0)
  notes           String?
  startDate       DateTime?
  expiresAt       DateTime?
  reminder24hSent Boolean  @default(false)
  reminder1hSent  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
  asset           Asset    @relation(fields: [assetId], references: [id])
  payments        Payment[]
  installments    Installment[]
}

model Installment {
  id            String   @id @default(cuid())
  reservationId String
  sequence      Int
  amount        Float
  dueDate       DateTime?
  status        String   @default("PENDING") // PENDING | PAID | OVERDUE | WAIVED
  paidAt        DateTime?
  paymentId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model Tool {
  id               String       @id @default(cuid())
  name             String
  description      String
  category         String
  dailyRate        Float
  weeklyRate       Float
  quantity         Int          @default(1)
  available        Int          @default(1)
  image            String?
  reservationHours Int?
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  rentals          ToolRental[]
}

model ToolRental {
  id          String   @id @default(cuid())
  userId      String
  toolId      String
  quantity    Int      @default(1)
  startDate   DateTime
  endDate     DateTime
  totalCost   Float
  status      String   @default("PENDING")
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  tool        Tool     @relation(fields: [toolId], references: [id])
  payments    Payment[]
}

model Worker {
  id               String        @id @default(cuid())
  name             String
  specialty        String
  experience       Int
  dailyRate        Float
  available        Boolean       @default(true)
  rating           Float         @default(4.5)
  image            String?
  bio              String?
  reservationHours Int?
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  hireRequests     HireRequest[]
}

model HireRequest {
  id            String   @id @default(cuid())
  userId        String
  workerId      String?
  serviceType   String
  description   String
  location      String
  startDate     DateTime
  endDate       DateTime?
  estimatedCost Float?
  status        String   @default("PENDING")
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
  worker        Worker?  @relation(fields: [workerId], references: [id])
  payments      Payment[]
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  clientId    String
  managerId   String?
  status      String   @default("PLANNING")
  budget      Float
  spent       Float    @default(0)
  startDate   DateTime?
  endDate     DateTime?
  location    String
  progress    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      User     @relation("ClientProjects", fields: [clientId], references: [id])
  manager     User?    @relation("ManagerProjects", fields: [managerId], references: [id])
  milestones  Milestone[]
  payments    Payment[]
}

model Milestone {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean  @default(false)
  amount      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String       @id @default(cuid())
  userId          String
  amount          Float
  currency        String       @default("USD")
  method          String       // STRIPE | BANK_TRANSFER | CASH | ADMIN_CONFIRMED | PROOF_UPLOAD
  // PENDING | APPROVED | REJECTED | COMPLETED | FAILED
  status          String       @default("PENDING")
  type            String       // DEPOSIT | FULL | INSTALLMENT | RENTAL | HIRE
  referenceId     String?
  stripeId        String?
  proofUrl        String?
  rejectReason    String?
  installmentId   String?
  reservationId   String?
  toolRentalId    String?
  hireRequestId   String?
  projectId       String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id])
  reservation     Reservation? @relation(fields: [reservationId], references: [id])
  toolRental      ToolRental?  @relation(fields: [toolRentalId], references: [id])
  hireRequest     HireRequest? @relation(fields: [hireRequestId], references: [id])
  project         Project?     @relation(fields: [projectId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String   @default("INFO") // INFO | PAYMENT | RESERVATION | VERIFICATION
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminActivityLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  entity    String?
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
  admin     User     @relation("AdminActor", fields: [adminId], references: [id])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model FinishedProject {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String
  category    String   @default("RESIDENTIAL")
  completedAt DateTime
  imageUrl    String?
  featured    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
