generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("construction_storage_PRISMA_DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String
  phone         String?
  role          String         @default("CLIENT")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  reservations  Reservation[]
  toolRentals   ToolRental[]
  hireRequests  HireRequest[]
  projects      Project[]      @relation("ClientProjects")
  managedProjects Project[]    @relation("ManagerProjects")
  payments      Payment[]
}

model Asset {
  id          String        @id @default(cuid())
  title       String
  description String
  type        String
  price       Float
  location    String
  size        String?
  bedrooms    Int?
  bathrooms   Int?
  images      String
  status      String        @default("AVAILABLE")
  features    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  reservations Reservation[]
}

model Reservation {
  id          String   @id @default(cuid())
  userId      String
  assetId     String
  status      String   @default("PENDING")
  deposit     Float
  notes       String?
  startDate   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  asset       Asset    @relation(fields: [assetId], references: [id])
  payments    Payment[]
}

model Tool {
  id          String       @id @default(cuid())
  name        String
  description String
  category    String
  dailyRate   Float
  weeklyRate  Float
  quantity    Int          @default(1)
  available   Int          @default(1)
  image       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  rentals     ToolRental[]
}

model ToolRental {
  id          String   @id @default(cuid())
  userId      String
  toolId      String
  quantity    Int      @default(1)
  startDate   DateTime
  endDate     DateTime
  totalCost   Float
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  tool        Tool     @relation(fields: [toolId], references: [id])
  payments    Payment[]
}

model Worker {
  id          String        @id @default(cuid())
  name        String
  specialty   String
  experience  Int
  dailyRate   Float
  available   Boolean       @default(true)
  rating      Float         @default(4.5)
  image       String?
  bio         String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  hireRequests HireRequest[]
}

model HireRequest {
  id          String   @id @default(cuid())
  userId      String
  workerId    String?
  serviceType String
  description String
  location    String
  startDate   DateTime
  endDate     DateTime?
  estimatedCost Float?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  worker      Worker?  @relation(fields: [workerId], references: [id])
  payments    Payment[]
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  clientId    String
  managerId   String?
  status      String   @default("PLANNING")
  budget      Float
  spent       Float    @default(0)
  startDate   DateTime?
  endDate     DateTime?
  location    String
  progress    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      User     @relation("ClientProjects", fields: [clientId], references: [id])
  manager     User?    @relation("ManagerProjects", fields: [managerId], references: [id])
  milestones  Milestone[]
  payments    Payment[]
}

model Milestone {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean  @default(false)
  amount      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String       @id @default(cuid())
  userId        String
  amount        Float
  currency      String       @default("USD")
  method        String
  status        String       @default("PENDING")
  type          String
  referenceId   String?
  stripeId      String?
  reservationId String?
  toolRentalId  String?
  hireRequestId String?
  projectId     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id])
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  toolRental    ToolRental?  @relation(fields: [toolRentalId], references: [id])
  hireRequest   HireRequest? @relation(fields: [hireRequestId], references: [id])
  project       Project?     @relation(fields: [projectId], references: [id])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

// Public showcase of completed builds (display + admin update)
model FinishedProject {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String
  category    String   @default("RESIDENTIAL")
  completedAt DateTime
  imageUrl    String?
  featured    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
