# Neon / Postgres (production uses construction_storage_PRISMA_DATABASE_URL from Vercel)
DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

JWT_SECRET="change-this-to-a-long-random-secret-at-least-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin bootstrap (created/updated on login)
ADMIN_EMAIL="admin@hamaconstruction.com"
ADMIN_PASSWORD="change-me-min-8-chars"
ADMIN_NAME="Hama Admin"

# One-time DB setup route secret
SETUP_SECRET="hama-setup-2026-secure-key-x9k2m"

# Vercel Blob (Storage → Blob → Connect to project)
# Auto-injected when you link a Blob store in the Vercel dashboard:
BLOB_READ_WRITE_TOKEN=""

# Optional Stripe
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
